<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.academia.frontend.AlunosController">
    <top>
        <HBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Button onAction="#addAluno" text="Adicionar Aluno" />
                <Button onAction="#editAluno" text="Editar" />
                <Button onAction="#deleteAluno" text="Excluir" />
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="alunosTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="nomeCol" text="Nome" />
                <TableColumn fx:id="cpfCol" text="CPF" />
                <TableColumn fx:id="planoCol" text="Plano" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <Button onAction="#backToDashboard" text="Voltar" BorderPane.alignment="CENTER" />
    </bottom>
</BorderPane>