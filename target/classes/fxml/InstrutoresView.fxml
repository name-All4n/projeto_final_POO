<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.frontend.controller.InstrutoresController" prefWidth="600" prefHeight="400">
    <children>
        <VBox spacing="8" AnchorPane.topAnchor="8" AnchorPane.leftAnchor="8" AnchorPane.rightAnchor="8">
            <HBox spacing="8">
                <Label text="Instrutores" style="-fx-font-size: 18"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Novo" onAction="#onNovo"/>
                <Button text="Remover" onAction="#onRemover"/>
            </HBox>
            <TableView fx:id="tableInstrutores" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="220"/>
                    <TableColumn fx:id="colCpf" text="CPF" prefWidth="180"/>
                    <TableColumn fx:id="colCref" text="CREF" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
